# Local development only. Cloud deployments inject these from Secret Manager / service config.
NODE_ENV=development

# Runtime login role (member of bob_api for the API, bob_worker for the worker).
# Create local roles with: pnpm operator dev:login-roles --api-password ... --worker-password ...
DATABASE_URL=postgres://bob_api_local:CHANGE_ME@localhost:5432/bob
DATABASE_POOL_MAX=5

# Schema-owning migrator/operator connection (pnpm db:migrate, pnpm operator ...).
MIGRATOR_DATABASE_URL=postgres://bob_migrator:bob_local_only@localhost:5432/bob
OPERATOR_DATABASE_URL=postgres://bob_migrator:bob_local_only@localhost:5432/bob

# HMAC key for API-key hashes (>= 32 chars). Rotating it invalidates every issued key.
API_KEY_PEPPER=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS
REQUEST_LOG=true

# Shared per-workspace admission limits (requests per minute per key).
ADMISSION_MUTATIONS_PER_MINUTE=60
ADMISSION_READS_PER_MINUTE=120
ADMISSION_MODEL_JOBS_PER_MINUTE=20

# Worker. Deployed: OIDC audience + allowlisted Scheduler/Tasks service accounts.
WORKER_OIDC_AUDIENCE=
WORKER_INVOKER_EMAILS=
# Local only: run the clock and task transport in-process (rejected in production).
WORKER_LOCAL_DRIVER=true
WORKER_LOCAL_TICK_SECONDS=5

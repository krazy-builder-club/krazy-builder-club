    "/v1/customers/{customer_id}/events": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Accept a source event (JSON envelope or text/plain note) and queue the Librarian",
        "description": "Commits the original source, a customer source revision, a Librarian job and its outbox row atomically. Acceptance is not proof of a brain update. Never triggers the Proactor.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "customer_id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "source_event_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "event_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "payload": {},
                  "corrects_event_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "source",
                  "source_event_id",
                  "event_type",
                  "occurred_at",
                  "payload"
                ],
                "additionalProperties": false
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "maxLength": 102400
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "job_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued"
                      ]
                    },
                    "source_revision": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "event_id",
                    "job_id",
                    "status",
                    "source_revision"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or missing required header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the required capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not permitted for this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds the bounded size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported inline content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
